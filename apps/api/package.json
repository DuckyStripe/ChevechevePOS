{
  "name": "chevechevepos-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "API de ChevechevePOS (Fastify 5 + PostgreSQL)",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/app.js",
    "lint": "eslint src scripts test",
    "typecheck": "tsc --noEmit",
    "prueba": "node --env-file-if-exists=../../.env scripts/preparar-pruebas.mjs && vitest run",
    "migrar": "node scripts/migrar.mjs",
    "importar:eleventa": "node scripts/importar-eleventa.mjs",
    "ota:publicar": "node scripts/ota-publicar.mjs",
    "ota:publicar-apk": "node scripts/ota-publicar-apk.mjs",
    "ota:regresar": "node scripts/ota-regresar.mjs"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^10.0.0",
    "bcryptjs": "^3.0.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "jose": "^6.0.0",
    "pg": "^8.11.5",
    "pino-pretty": "^13.0.0",
    "read-excel-file": "^9.3.20",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.5",
    "eslint": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
