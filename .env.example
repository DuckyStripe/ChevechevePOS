# Copia a .env (no se versiona). En Dokploy van en la pestana Environment.

# ── Base de datos ──
POSTGRES_USER=chevechevepos
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=chevechevepos
DB_PORT=5436

# ── API ──
# Minimo 32 caracteres aleatorios: openssl rand -hex 32
JWT_SECRET=cambia-esto-por-un-secreto-aleatorio-de-32-o-mas-caracteres
# Llave AES-256-GCM de los enlaces de cliente (min. 32; cambiarla obliga a regenerar enlaces)
SECRETO_ENLACES=cambia-esto-por-otro-secreto-aleatorio-de-32-o-mas-caracteres
SESION_WEB_HORAS=12
SESION_APP_DIAS=30
# Ruta a un JSON de cuenta de servicio (push); vacia = sin push
FCM_CUENTA_SERVICIO=
# ARCHIVOS_DIR=/datos/archivos
LOG_LEVEL=info
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60000
RUN_MIGRATIONS_ON_BOOT=true
API_PORT=3860

# ── Web (BFF) ──
# COOKIE_SECURE=false   # solo si se sirve sin HTTPS fuera del compose de desarrollo
BACKEND_TIMEOUT_MS=15000
WEB_PORT=3760

# ── Solo fuera de Docker (npm run dev en apps/api y apps/web) ──
# DATABASE_URL=postgresql://chevechevepos:cambia-esta-contrasena@127.0.0.1:5436/chevechevepos
# API_INTERNAL_URL=http://127.0.0.1:3860

# ── Pruebas (local; el script rechaza otro host, puerto o base) ──
DATABASE_URL_PRUEBAS=postgresql://chevechevepos:cambia-esta-contrasena@127.0.0.1:5436/chevechevepos_pruebas

# ── Respaldos (servicio `respaldo`, solo produccion; CONTRATOS §3.2) ──
RESPALDO_DESTINO=
RESPALDO_RCLONE_CONF=/run/secrets/rclone.conf
